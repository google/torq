http_file(
    name = "simpleperf_libsimpleperf_report_linux",
    sha256 = "5b3e81bfdd8bab53f4e7872f01b2f67b9fa9518bd6a276e46a7fc0ae8f3dbcd0",
    urls = ["https://android.googlesource.com/platform/system/extras/+/" + SIMPLEPERF_COMMIT + "/simpleperf/scripts/bin/linux/x86_64/libsimpleperf_report.so?format=TEXT"],
)

http_file(
    name = "simpleperf_libsimpleperf_report_darwin",
    sha256 = "8832a0c3d955f6aeaf1e99cd521a7ad196cc3934bf2ba5010a03d7622a1e9a43",
    urls = ["https://android.googlesource.com/platform/system/extras/+/" + SIMPLEPERF_COMMIT + "/simpleperf/scripts/bin/darwin/x86_64/libsimpleperf_report.dylib?format=TEXT"],
)
